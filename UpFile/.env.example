# ====================================================================
# LDMega Upload System — Environment Variables
# Sao chép tệp này thành .env và điền thông tin thực tế
# KHÔNG bao giờ commit file .env lên GitHub
# ====================================================================

# === GOOGLE OAUTH 2.0 — ACCOUNT A (Owner) ===
# Lấy từ Google Cloud Console > APIs & Services > Credentials
# Loại: OAuth 2.0 Client ID (Web Application)
# Bắt buộc: API Drive phải được bật trong project này
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Refresh Token của Account A (Owner - chủ thư mục Drive)
# Tạo bằng cách: chạy script oauth_setup.js hoặc dùng OAuth Playground
# URL: https://developers.google.com/oauthplayground/
# Scopes cần: https://www.googleapis.com/auth/drive
OWNER_REFRESH_TOKEN=your_owner_account_A_refresh_token

# === GOOGLE DRIVE ===
ROOT_FOLDER_ID=1_gUGMTzYbXbY4qXGJwGl9NTftwaOsG0I

# Folder IDs của 8 phòng ban (không thay đổi trừ khi Drive thay đổi)
FOLDER_DR=12S3Bxy88t-d3wW7ZgbgG-Kk4ugvoBB3k
FOLDER_HR=1qStyvzjuajoqutJNq2nVEk2YhdkS4MCb
FOLDER_ACC=18ooykF5kTRNsM9i4ojeJtaksR5MCZ7s-
FOLDER_ASSET=1DaVefTGpptuekpGFoedf8HLbOTqPP_72
FOLDER_SALE=11m6vWiR-xBeCFPCwUxwdqhInxzbUD9f2
FOLDER_MKT=1B1PbZiNEHqaxzkJxZbibUCZzKgXMElxk
FOLDER_TASK=1ErnT6mRe2hJplIyx5xYz8tt5tdbNObY8
FOLDER_BOD=15OEUPdY46nHdl51if-UhJNX9QmRXQd8R

# === GOOGLE SHEETS ===
SPREADSHEET_ID=1nLqh8PR37kUYqiRL2ITRuG6GWhCh2udQs-lNeAkSUuw
SHEET_UPLOAD_TAB=UPload
SHEET_LOG_TAB=Upload_Log

# === CLOUDFLARE WORKER ===
# WORKER_URL: URL của Cloudflare Worker sau khi deploy
# Dùng trong frontend để gọi API
WORKER_URL=https://ldmega-upload.your-subdomain.workers.dev

# ALLOWED_ORIGINS: Các origin được phép gọi API (CORS)
# Sau khi deploy frontend, điền URL thực vào đây
ALLOWED_ORIGINS=http://localhost:5173,https://your-frontend-domain.com

# === SECURITY ===
# JWT secret key để ký nội bộ session token giữa frontend và worker
# Tạo bằng: openssl rand -base64 32
JWT_SECRET=your_random_jwt_secret_min_32_chars

# Rate limiting: số request tối đa mỗi nhân viên mỗi phút
RATE_LIMIT_RPM=30

# === FRONTEND ===
# Google OAuth Client ID dùng cho "Sign in with Google" ở frontend
# Thường giống GOOGLE_CLIENT_ID nếu dùng cùng GCP project
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
VITE_WORKER_URL=https://ldmega-upload.your-subdomain.workers.dev
