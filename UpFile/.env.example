# ==============================================================================
# UpFile - Cấu hình biến môi trường mẫu (.env)
# Sao chép tệp này thành .env trong thư mục UpFile và điền các thông tin của bạn
# ==============================================================================

# 1. ID Thư mục Google Drive đích để lưu tệp
# Mặc định theo yêu cầu: https://drive.google.com/drive/folders/1_gUGMTzYbXbY4qXGJwGl9NTftwaOsG0I
DRIVE_FOLDER_ID=1_gUGMTzYbXbY4qXGJwGl9NTftwaOsG0I

# 2. Cấu hình Telegram Bot
# Tạo bot qua @BotFather trên Telegram: https://t.me/BotFather để lấy Token
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# (Tùy chọn) ID chat nhận thông báo hoặc cho phép riêng tư
TELEGRAM_CHAT_ID=

# 3. Google Drive API Credentials (Dành cho Python engine)
# Loại xác thực: "oauth" hoặc "service_account"
AUTH_TYPE=oauth
# Đường dẫn tệp credentials (có thể dùng chung file trong FolderSyncGGdriver/credentials/)
CREDENTIALS_PATH=../FolderSyncGGdriver/credentials/credentials.json
TOKEN_PATH=../FolderSyncGGdriver/credentials/token.json

# 4. Link Script Google Apps Script Web App (Dành cho Upload qua Web / REST API)
# Lấy từ URL sau khi Deploy Web App trên script.google.com
# Ví dụ: https://script.google.com/macros/s/AKfycbx.../exec
GAS_WEBAPP_URL=https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec
