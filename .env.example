# ==============================================================================
# LDMega - Cấu hình biến môi trường mẫu (.env)
# Sao chép file này thành .env và điền các khóa API tương ứng
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. GROQ API (AI Inference - Llama 3.3, Mixtral)
# Lấy miễn phí tại: https://console.groq.com/keys
# ------------------------------------------------------------------------------
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_DEFAULT_MODEL=llama-3.3-70b-versatile

# ------------------------------------------------------------------------------
# 2. TELEGRAM BOT API
# Tạo bot qua @BotFather trên Telegram: https://t.me/BotFather
# Lấy Chat ID qua @userinfobot: https://t.me/userinfobot
# ------------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRstuVWXyz
TELEGRAM_CHAT_ID=123456789

# ------------------------------------------------------------------------------
# 3. GOOGLE DRIVE / WORKSPACE API
# Thông tin OAuth2 hoặc Service Account
# ------------------------------------------------------------------------------
AUTH_TYPE=oauth
CREDENTIALS_PATH=FolderSyncGGdriver/credentials/credentials.json
DRIVE_FOLDER_ID=1L99nIdUz1V-Ios22gWg45HtwQvOmNN2U

# ------------------------------------------------------------------------------
# 4. CLOUDFLARE (Workers & Pages)
# Lấy API Token tại: https://dash.cloudflare.com/profile/api-tokens
# ------------------------------------------------------------------------------
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here

# ------------------------------------------------------------------------------
# 5. GOOGLE APPS SCRIPT (CLASP)
# ID dự án Apps Script (lấy từ URL trình duyệt trong script.google.com)
# ------------------------------------------------------------------------------
GAS_SCRIPT_ID=your_google_apps_script_id_here
